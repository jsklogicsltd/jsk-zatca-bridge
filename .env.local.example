# Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ============================================
# Application Configuration
# ============================================

# Base URL for the application (used for SEO, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, staging, production)
NODE_ENV=development

# ============================================
# Authentication
# ============================================

# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Session configuration
SESSION_MAX_AGE=2592000

# ============================================
# Database
# ============================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/zatca_bridge

# ============================================
# ZATCA API Configuration
# ============================================

# ZATCA API Base URL (use sandbox for testing)
ZATCA_API_URL=https://sandbox.zatca.gov.sa/api
# Production: https://api.zatca.gov.sa

# ZATCA API Credentials
ZATCA_API_KEY=your-zatca-api-key
ZATCA_API_SECRET=your-zatca-api-secret

# CSID Configuration
ZATCA_CSID=your-csid-here

# ============================================
# Email Configuration (for notifications)
# ============================================

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@zatcabridge.com

# ============================================
# Storage (for invoice files, exports, etc.)
# ============================================

# AWS S3 or compatible storage
S3_BUCKET_NAME=zatca-bridge-storage
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# Or use local file storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# ============================================
# Error Monitoring (optional)
# ============================================

# Sentry DSN for error tracking
SENTRY_DSN=your-sentry-dsn

# ============================================
# Analytics (optional)
# ============================================

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Feature Flags
# ============================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_EXCEL_UPLOAD=true
NEXT_PUBLIC_ENABLE_API_ACCESS=true
NEXT_PUBLIC_ENABLE_BATCH_PROCESSING=true

# ============================================
# Rate Limiting
# ============================================

# API rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Security
# ============================================

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.zatcabridge.com

# ============================================
# Developer Tools
# ============================================

# Enable debug logging
DEBUG=false

# Show detailed error messages in production
SHOW_ERROR_DETAILS=false
