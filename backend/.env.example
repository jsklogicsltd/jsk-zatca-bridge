# Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=ZATCA Bridge API
APP_VERSION=1.0.0
DEBUG=True

# API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (Update for production)
DATABASE_URL=postgresql+asyncpg://zatca:zatca_password@localhost:5432/zatca_bridge

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ZATCA API
ZATCA_API_URL=https://sandbox.zatca.gov.sa/api
ZATCA_API_KEY=your-api-key-here
ZATCA_CSID=your-csid-here

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Fernet key for encrypting stored ZATCA credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY (dev only — NOT safe for prod).
ENCRYPTION_KEY=
