# Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=ZATCA Bridge API
APP_VERSION=1.0.0
DEBUG=True

# API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (Update for production)
DATABASE_URL=postgresql+asyncpg://zatca:zatca_password@localhost:5432/zatca_bridge

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ZATCA API
ZATCA_API_URL=https://sandbox.zatca.gov.sa/api
ZATCA_API_KEY=your-api-key-here
ZATCA_CSID=your-csid-here

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase (Auth + Storage)
# Verifies frontend-issued Supabase JWTs. The backend pulls the public signing
# key(s) from {SUPABASE_URL}/auth/v1/.well-known/jwks.json — no secret needed
# for projects on the modern asymmetric (ES256/RS256) keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional: legacy HS256 shared secret. Only set if your project still has
# unexpired tokens signed with the old shared secret. Find it under
# Settings → API → JWT Keys → Legacy JWT Secret.
SUPABASE_JWT_SECRET=
# Service role key — only needed for admin/storage operations from the backend.
SUPABASE_SERVICE_ROLE_KEY=

# Fernet key for encrypting stored ZATCA credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY (dev only — NOT safe for prod).
ENCRYPTION_KEY=
